DJANGO_DEBUG=False
DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
# Only list reverse-proxy IP/CIDR ranges that you control and that sanitize X-Forwarded-For.
DJANGO_TRUSTED_PROXY_IPS=
# Local Compose defaults only. Replace the password in any shared environment.
POSTGRES_DB=nexora
POSTGRES_USER=nexora
POSTGRES_PASSWORD=replace-with-a-random-local-postgres-password
# Compose constructs DATABASE_URL from POSTGRES_*; direct/hosted execution sets it explicitly.
# DATABASE_URL=postgresql://nexora:password@127.0.0.1:5432/nexora
POSTGRES_SSLMODE=prefer
DJANGO_CACHE_URL=redis://cache:6379/1
DJANGO_LOG_LEVEL=INFO
DJANGO_LOG_FORMAT=json
# Optional error monitoring. Leave blank to disable; never expose this DSN to templates.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_PROFILES_SAMPLE_RATE=0.0
# Configure verified operator/contact details before public launch.
NEXORA_LEGAL_NAME=
NEXORA_LEGAL_ADDRESS=
NEXORA_SUPPORT_EMAIL=
NEXORA_PHONE=
# Add only NEXORA's real public profile URLs. Leave blank to hide the link.
NEXORA_FACEBOOK_URL=
NEXORA_X_URL=
NEXORA_INSTAGRAM_URL=
NEXORA_TIKTOK_URL=
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=replace-with-smtp-username
EMAIL_HOST_PASSWORD=replace-with-smtp-app-password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=NEXORA <noreply@example.com>
# Keep this secret only in .env; it is never sent to the browser.
GEMINI_API_KEY=replace-with-google-ai-studio-key
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_ENABLED=False
GEMINI_CONNECT_TIMEOUT=2
GEMINI_READ_TIMEOUT=6
GEMINI_MAX_ATTEMPTS=2
GEMINI_FAILURE_COOLDOWN_SECONDS=20
# Optional Meta Model API provider for Ask NEXORA. Meta Model API supports
# text output (including image understanding), not image generation.
NEXORA_AI_PROVIDER=gemini
META_MODEL_API_KEY=replace-with-meta-model-api-key
META_MODEL=muse-spark-1.1
META_MODEL_ENABLED=False
META_MODEL_CONNECT_TIMEOUT=2
META_MODEL_READ_TIMEOUT=8
META_MODEL_MAX_ATTEMPTS=2
META_MODEL_FAILURE_COOLDOWN_SECONDS=20
EMAIL_VERIFICATION_EXPIRY_SECONDS=600
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
EMAIL_VERIFICATION_RESEND_COOLDOWN=60
EMAIL_VERIFICATION_MAX_SENDS_PER_HOUR=5
SIGNUP_RATE_LIMIT_PER_IP=10
SIGNUP_RATE_LIMIT_PER_EMAIL=3
SIGNUP_RATE_LIMIT_WINDOW=3600
VERIFICATION_RECOVERY_RATE_LIMIT_PER_IP=10
VERIFICATION_RECOVERY_RATE_LIMIT_PER_EMAIL=5
VERIFICATION_RECOVERY_RATE_LIMIT_WINDOW=3600
LOGIN_RATE_LIMIT_PER_IP=10
LOGIN_RATE_LIMIT_PER_ACCOUNT=5
LOGIN_RATE_LIMIT_WINDOW=900
ADMIN_LOGIN_RATE_LIMIT_PER_IP=10
ADMIN_LOGIN_RATE_LIMIT_PER_ACCOUNT=5
ADMIN_LOGIN_RATE_LIMIT_WINDOW=900
PASSWORD_RESET_RATE_LIMIT_PER_IP=5
PASSWORD_RESET_RATE_LIMIT_PER_ACCOUNT=3
PASSWORD_RESET_RATE_LIMIT_WINDOW=3600
WEB_CONCURRENCY=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=60
